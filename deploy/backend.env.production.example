# Salin ke /var/www/namaqu/backend/.env di server, lalu isi bagian yang ditandai <...>
APP_NAME=NamaQu
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.meongganas.my.id/namaqu

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=7

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=namaqu
DB_USERNAME=namaqu
DB_PASSWORD=<password-db-yang-kuat>

# Penting: domain api.meongganas.my.id dipakai bersama app lain,
# jadi cookie NamaQu dibatasi ke /namaqu dan diberi nama unik.
SESSION_DRIVER=file
SESSION_LIFETIME=480
SESSION_PATH=/namaqu
SESSION_COOKIE=namaqu_session
SESSION_SECURE_COOKIE=true

CACHE_STORE=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public

# Foto konten disimpan di Cloudinary (bukan di disk server)
MEDIA_DISK=cloudinary
# Dashboard Cloudinary -> "API environment variable": cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
CLOUDINARY_FOLDER=namaqu
BCRYPT_ROUNDS=10

# Frontend di Vercel: dipanggil tiap konten berubah di admin
FRONTEND_REVALIDATE_URL=https://<domain-vercel-kamu>/api/revalidate
FRONTEND_REVALIDATE_SECRET=<string-acak-panjang, sama dengan REVALIDATE_SECRET di Vercel>
